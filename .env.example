# Local development defaults to SQLite; production can use PostgreSQL.
DATABASE_URL=
SQLITE_PATH=data/luma.sqlite
APP_ORIGIN=
SOURCE_ENCRYPTION_KEY=
# Dedicated stream-check lanes (1-16), alongside separate import/metadata workers.
HEALTH_CONCURRENCY=8
# Per-provider parallel checks (1-16); expensive media probes remain capped at 4.
HEALTH_ORIGIN_CONCURRENCY=4
HEALTH_FAILURE_THRESHOLD=3
HEALTH_INTERVAL_MS=21600000
DEV_WORKER_AUTOSTART=true
WORKER_LOG_LEVEL=normal
TRUST_PROXY=false

# Server-side conversion for MKV, AVI, MPEG-TS and unsupported browser codecs.
# Install FFmpeg (including ffprobe) locally; the Docker image includes it.
MEDIA_CONVERSION=true
MEDIA_MAX_PROCESSES=2
# Optional absolute executable paths when the tools are not on PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# Automatic no-key metadata: TVmaze series; Wikidata/Wikipedia films and fallback series.
METADATA_AUTO_ENRICH=true
METADATA_LANGUAGE=en
# Recommended descriptive identity/contact when making Wikimedia requests.
METADATA_USER_AGENT=Lume-Metadata/1.0 (automatic catalog lookup)
# Optional configured licensed provider; preferred when both values are set.
METADATA_PROVIDER_URL=
METADATA_API_KEY=
# Optional TMDB read access token or v3 key for broader film/series artwork.
# Use a provider license appropriate to your deployment and include TMDB attribution.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

PLAYBACK_SIGNER_URL=
PLAYBACK_SIGNER_API_KEY=
REQUIRE_PLAYBACK_SIGNER=false
POSTGRES_PASSWORD=
